---
import {CollectionEntry, getCollection} from 'astro:content';
import ClickHandler from 'src/components/ClickHandler.svelte';
import Heading from 'src/components/Heading.astro';
import Link from 'src/components/Link.astro';
import Sidebar from 'src/components/Sidebar.svelte';
import Subtitle from 'src/components/Subtitle.astro';
import Title from 'src/components/Title.astro';
import BaseHead from '../components/BaseHead.astro';
import DateView from '../components/DateView.astro';
import ProtectedEmailProvider from 'src/components/ProtectedEmailProvider.svelte';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: {slug: article.slug},
    props: article,
  }));
}
type Props = CollectionEntry<'articles'>;

const {
  data: {title, description, date, image},
  render,
} = Astro.props;
const {Content, headings} = await render();
---

<style is:global>
  .article-layout article {
    min-width: 0;
  }

  .article-home {
    color: var(--accentColor);
  }

  .article-title {
    margin-top: 48px;
  }

  .article-footer {
    margin-top: 80px;
  }

  .article-footer h2 + h2 {
    margin-top: 4px;
  }

  .markdown {
    padding-top: 48px;
    overflow-wrap: break-word;
  }

  .markdown p {
    margin: 0;
  }

  .markdown p + p {
    margin-top: var(--unit);
  }

  .markdown h3,
  .markdown h4 {
    color: var(--gray);
    margin-top: 48px;
    margin-bottom: var(--unit);
    scroll-margin-top: 32px;
  }

  .markdown h3 + h4 {
    margin-top: var(--unit);
  }

  .markdown h5 {
    color: var(--gray);
    margin-bottom: var(--unit);
  }

  .markdown strong {
    color: var(--linkColor);
  }

  .markdown a {
    color: var(--linkColor);
    text-decoration: underline;
    text-decoration-color: #555;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .markdown a:hover {
    color: var(--hoverLinkColor);
    text-decoration-color: currentColor;
  }

  .markdown .expressive-code {
    margin: var(--unit) 0;
    letter-spacing: normal;
  }

  .markdown code {
    font-family: var(--mono);
    font-size: var(--codeFontSize);
    font-weight: 400;
    line-height: var(--codeLineHeight);
    letter-spacing: normal;
  }

  .markdown :not(pre) > code {
    font-size: inherit;
    line-height: inherit;
  }

  .markdown p > code,
  .markdown li > code {
    background: var(--darkerGrayBackground);
    border-radius: 2px;
    padding: 0 3px;
    font-variant-ligatures: none;
  }

  .markdown .caps {
    font: inherit;
  }

  .markdown blockquote {
    margin: 32px 0;
    padding: 0 0 0 var(--unit);
    border-left: 1px solid #444;
    color: var(--gray);
  }

  .markdown blockquote:not(.quote) {
    --fontSize: 14px;
    --lineHeight: 1.5;
    --codeFontSize: var(--fontSize);
    --ec-codeFontSize: var(--codeFontSize);
    --ec-codeLineHt: var(--codeLineHeight);
    font-size: var(--fontSize);
    line-height: var(--lineHeight);
    letter-spacing: normal;
  }

  .markdown blockquote h4 {
    margin-top: 0;
  }

  .markdown blockquote.quote {
    font-style: normal;
    color: var(--accentColor);
  }

  .markdown blockquote.quote em,
  .markdown blockquote.quote i {
    font-style: inherit;
  }

  .markdown .thanks {
    font-style: italic;
    color: var(--gray);
  }

  .markdown img,
  .markdown video,
  .markdown iframe {
    max-width: 100%;
  }

  .markdown img {
    height: auto;
    margin: 32px 0 8px;
  }

  .markdown figure {
    margin: 32px 0;
  }

  .markdown figcaption {
    color: var(--gray);
    font-size: 12px;
    line-height: var(--lineHeight);
    letter-spacing: normal;
    margin-bottom: 32px;
  }

  .markdown .prev-next {
    display: none;
  }

  .markdown ol,
  .markdown ul {
    margin: var(--unit) 0;
    padding-left: var(--unit);
  }

  .markdown ol {
    padding-left: calc(1ch + 1em);
  }

  .markdown ol > li::marker {
    content: counter(list-item) '\2003';
    color: var(--gray);
    font-variant-numeric: tabular-nums;
  }

  .markdown li + li {
    margin-top: 8px;
  }

  .svg {
    border: 1px solid #333;
    display: block;
    margin: 32px 0;
    width: 100%;
  }

  .red-border {
    border: 3px solid #f00;
  }

  @media (min-width: 1200px) {
    .article-layout {
      display: grid;
      grid-template-columns: var(--sidebarWidth) minmax(0, var(--maxColumn));
      gap: 80px;
      max-width: calc(var(--sidebarWidth) + var(--maxColumn) + 144px);
      align-items: start;
    }

  }
</style>

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <ProtectedEmailProvider siteKey="0x4AAAAAAACiX56uiMszpvqE" endpoint="/email" client:load />
    <main class="article-layout">
      <Sidebar title={title} headings={headings} client:load />
      <article>
        <Heading>
          <Link class="article-home" href="/">Stefano J. Attardi</Link>
        </Heading>
        <Title id="top" class="article-title">
          {title}
        </Title>
        <DateView date={date} />
        <ClickHandler client:load>
          <div class="markdown">
            <Content />
          </div>
        </ClickHandler>
        <footer class="article-footer">
          <Heading>
            <Link href="/">Stefano J. Attardi</Link>
          </Heading>
          <Subtitle>Member of technical staff, <Link href="https://openai.com/">OpenAI</Link></Subtitle>
        </footer>
      </article>
    </main>
  </body>
</html>
