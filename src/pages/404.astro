---
import BaseHead from '../components/BaseHead.astro';
import Title from '../components/Title.astro';
import Subtitle from '../components/Subtitle.astro';
import Button from '../components/Button.svelte';
import {HomeIcon} from 'astro-feather';
import IconLink from '../components/IconLink.astro';
---

<style>
  .not-found {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 80vh;
  }
  .subtitle {
    margin-top: calc(var(--unit) / 2);
    margin-bottom: calc(var(--unit) * 2);
  }
</style>
<html lang="en">
  <head>
    <BaseHead
      title="Page not found — Stefano J. Attardi"
      description="Member of technical staff at OpenAI. Writing, projects, and open-source work by Stefano J. Attardi."
    />
  </head>
  <body>
    <div class="not-found">
      <Title>Not found</Title>
      <Subtitle class="subtitle">There’s nothing here.</Subtitle>
      <IconLink href="/" label="Home"><HomeIcon /></IconLink>
    </div>
  </body>
</html>
