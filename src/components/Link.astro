---
type Props = {
  href: string;
  class?: string;
  disabled?: boolean;
  rel?: string;
};

const {href, class: className, rel, disabled = false} = Astro.props;
---

<a href={href} rel={rel} class:list={[className, {disabled}]}><slot /></a>

<style>
  a {
    color: var(--linkColor);
    line-height: inherit;
    transition: color 0.15s ease;
    text-decoration: none;
  }

  a:hover {
    color: var(--hoverLinkColor);
    text-decoration: underline;
  }

  a:active {
    color: var(--activeLinkColor);
    transition-duration: 0.1s;
  }

  a.disabled {
    color: var(--grayDisabled);

    a:hover {
      color: var(--grayDisabled);
    }

    a:active {
      color: var(--grayDisabled);
    }
  }
</style>
