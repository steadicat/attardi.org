---
import '@fontsource/geist-mono/400.css';
import '@fontsource/dm-sans/500.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {title, description, image = ''} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/images/icon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="alternate" type="application/rss+xml" title="RSS feed" href="/rss.xml" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  html,
  body {
    margin: 0;
    padding: 0;
  }

  :root {
    --sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --serif: var(--sans);
    --mono: 'Geist Mono', 'SF Mono', Consolas, Monaco, monospace;

    --unit: 24px;
    --fontSize: 20px;
    --lineHeight: 1.35;
    --codeFontSize: 14px;
    --codeLineHeight: 1.5;
    --maxColumn: 640px;
    --mobileMargin: var(--unit);
    --sidebarWidth: 240px;

    --textColor: #dededc;
    --accentColor: #ff8c80;

    --linkColor: #eeedeb;
    --hoverLinkColor: var(--accentColor);
    --activeLinkColor: var(--accentColor);

    --gray: #90908d;
    --grayDisabled: #666;
    --darkerGrayBackground: #191919;
    --grayBackground: #101010;
    --codeBackground: #1f1f1f;
    --borderColor: #444;
    --subtleBorderColor: #333;
    --linkUnderlineColor: #555;
    --scrollbarColor: #333;
    --selectionTextColor: #000;
    --externalHoverLightness: 76%;
    --externalHoverChroma: 0.12;

    --white: #000;
    --hoverBackground: #191919;
    color-scheme: dark;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --textColor: #272725;
      --accentColor: #c43c2e;
      --linkColor: #171716;
      --gray: #6a6a65;
      --grayDisabled: #aaa;
      --darkerGrayBackground: #efefec;
      --grayBackground: #f7f7f5;
      --codeBackground: #f7f7f5;
      --borderColor: #d6d6d1;
      --subtleBorderColor: #deded9;
      --linkUnderlineColor: #b5b5af;
      --scrollbarColor: #c5c5bf;
      --selectionTextColor: #fff;
      --externalHoverLightness: 54%;
      --externalHoverChroma: 0.09;
      --white: #fff;
      --hoverBackground: #efefec;
      color-scheme: light;
    }
  }

  html {
    background: var(--white);
    color: var(--textColor);
    font-family: var(--sans);
    font-size: var(--fontSize);
    font-weight: 500;
    line-height: var(--lineHeight);
    letter-spacing: -0.015em;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100vh;
  }

  main {
    width: 100%;
    max-width: calc(var(--maxColumn) + 64px);
    padding: 80px 32px 120px;
    margin: 0 auto;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  strong,
  b,
  .serifRegular,
  .serifBold,
  .sansRegular,
  .sansBold {
    font-family: var(--sans);
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  a {
    color: var(--linkColor);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 5px;
  }

  ::selection {
    background: var(--accentColor);
    color: var(--selectionTextColor);
  }

  .sansCaps,
  .sansBoldCaps,
  .serifCaps {
    font: inherit;
  }

  .xl,
  .l,
  .m,
  .s,
  .xs {
    font-size: var(--fontSize);
    line-height: var(--lineHeight);
  }

  @media (max-width: 600px) {
    main {
      padding: 48px var(--mobileMargin) 80px;
    }
  }
</style>
