---
type Props = {
  date: Date;
};

const {date} = Astro.props;
---

<style>
  time {
    display: block;
    color: var(--gray);
    margin-top: 4px;
    font-size: 12px;
    line-height: var(--lineHeight);
  }
</style>

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString('en-us', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  }
</time>
